    "pino": "^9.6.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "swagger-ui-express": "^5.0.1",
    "web3": "^4.16.0",
    "web3-validator": "^2.0.6",
    "yaml": "^2.7.0",
    "zod": "^3.24.1"
  },
